# フォーム送信の受け口（D-064）。send.php 以外はブラウザから直接開けないようにする
# （config.php・result-copy.json・data/ を保護。Apache 2.2 / 2.4 / LiteSpeed のどれでも効く書き方）
<FilesMatch "^(?!send\.php$).*$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
